function(xsc_add_compression_dependencies)
    include(FetchContent)
    if(NOT TARGET QuaZip)
        if(NOT TARGET ZLIB::ZLIB)
            set(ZLIB_BUILD_SHARED OFF)
            set(ZLIB_BUILD_STATIC ON)
            set(ZLIB_BUILD_TESTING OFF)
            set(ZLIB_INSTALL OFF)
            FetchContent_Declare(ZLIB GIT_REPOSITORY https://github.com/madler/zlib.git GIT_TAG v1.4 OVERRIDE_FIND_PACKAGE)
            FetchContent_MakeAvailable(ZLIB)
            if(NOT TARGET ZLIB::ZLIB)
                add_library(ZLIB::ZLIB ALIAS zlibstatic)
            endif()
            set_target_properties(zlibstatic PROPERTIES POSITION_INDEPENDENT_CODE ON)
        endif()
        set(QUAZIP_QT_MAJOR_VERSION 6)
        set(QUAZIP_BZIP2 OFF)
        set(QUAZIP_INSTALL OFF)
        set(QUAZIP_ENABLE_QTEXTCODEC OFF)
        set(BUILD_SHARED_LIBS OFF)
        FetchContent_Declare(quazip GIT_REPOSITORY https://github.com/stachenov/quazip.git GIT_TAG v1.7.2)
        FetchContent_MakeAvailable(quazip)
        set_target_properties(QuaZip PROPERTIES POSITION_INDEPENDENT_CODE ON)
    endif()
    if(NOT TARGET libzstd_static)
        set(ZSTD_BUILD_PROGRAMS OFF)
        set(ZSTD_BUILD_TESTS OFF)
        set(ZSTD_BUILD_CONTRIB OFF)
        set(ZSTD_BUILD_SHARED OFF)
        set(ZSTD_BUILD_STATIC ON)
        FetchContent_Declare(zstd GIT_REPOSITORY https://github.com/facebook/zstd.git GIT_TAG v1.5.7 SOURCE_SUBDIR build/cmake)
        FetchContent_MakeAvailable(zstd)
        set_target_properties(libzstd_static PROPERTIES POSITION_INDEPENDENT_CODE ON)
    endif()
endfunction()
